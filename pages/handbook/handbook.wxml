<view class="page">
  <!-- 顶部 -->
  <view class="hero">
    <text class="hero-title">整理手账本</text>
    <text class="hero-sub">每月一册 · 用整理治愈生活</text>
  </view>

  <!-- 当月手账 -->
  <view class="current-month">
    <text class="month-title">2026年7月手账本</text>
    <view class="features">
      <text class="feature-tag">A4双面彩色打印</text>
      <text class="feature-tag">短边翻转</text>
      <text class="feature-tag">对折装订</text>
    </view>
    <button class="btn-download" bindtap="tapDownload">📥 观看广告后即可免费下载</button>
  </view>

  <!-- 全年主题预告 -->
  <view class="archive">
    <text class="archive-title">2026·全年主题预告</text>
    <view class="theme-list">
      <view class="theme-item done"><text class="theme-month">1月</text><text class="theme-name">建立整理秩序</text><text class="theme-check">✓</text></view>
      <view class="theme-item done"><text class="theme-month">2月</text><text class="theme-name">数字极简</text><text class="theme-check">✓</text></view>
      <view class="theme-item done"><text class="theme-month">3月</text><text class="theme-name">衣柜换季</text><text class="theme-check">✓</text></view>
      <view class="theme-item done"><text class="theme-month">4月</text><text class="theme-name">探寻滋养</text><text class="theme-check">✓</text></view>
      <view class="theme-item done"><text class="theme-month">5月</text><text class="theme-name">工作整理</text><text class="theme-check">✓</text></view>
      <view class="theme-item done"><text class="theme-month">6月</text><text class="theme-name">优化饮食环境</text><text class="theme-check">✓</text></view>
      <view class="theme-item current"><text class="theme-month">7月</text><text class="theme-name">规划家庭空间</text><text class="theme-tag">最新</text></view>
      <view class="theme-item"><text class="theme-month">8月</text><text class="theme-name">梳理人际关系</text></view>
      <view class="theme-item"><text class="theme-month">9月</text><text class="theme-name">整理纪念品</text></view>
      <view class="theme-item"><text class="theme-month">10月</text><text class="theme-name">囤货盘点</text></view>
      <view class="theme-item"><text class="theme-month">11月</text><text class="theme-name">家的保养</text></view>
      <view class="theme-item"><text class="theme-month">12月</text><text class="theme-name">全年复盘</text></view>
    </view>
    <text class="archive-note">*实际推出内容可能优化调整，请以最终版本为准</text>
  </view>

  <!-- VIP会员 -->
  <view class="vip-section">
    <view class="vip-card">
      <view class="vip-badge"><text>VIP</text></view>
      <text class="vip-title">加入「改变从整理开始」年度会员</text>
      <view class="vip-benefits">
        <text class="vip-benefit">✨ 每月提前获赠整理手账本</text>
        <text class="vip-benefit">💬 群内随时提问，有问必答</text>
        <text class="vip-benefit">🤝 同频伙伴一起坚持，告别三分钟热度</text>
      </view>
      <text class="vip-more" bindtap="openArticle">了解年度会员详情 ›</text>
    </view>
  </view>
</view>

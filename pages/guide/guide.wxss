page {
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===== 顶部进度 ===== */
.header {
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.progress-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(135deg, #07c160, #1296db);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  white-space: nowrap;
}

/* ===== 网格 ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.card {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 8rpx 16rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
  transition: transform 0.15s;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
}

.card:active {
  transform: scale(0.95);
}

.card-icon {
  width: 72rpx;
  height: 72rpx;
  font-size: 64rpx;
  line-height: 72rpx;
  text-align: center;
  margin-bottom: 8rpx;
}
.card-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  display: block;
}

.card-title {
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

/* 未开始 */
.card-not_started .card-icon {
  opacity: 0.5;
}
.card-not_started .card-title {
  color: #bbb;
}

/* 进行中 */
.card-in_progress {
  border: 3rpx solid #1296db;
}
.card-in_progress .card-title {
  color: #333;
  font-weight: 600;
}
.card-timer {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  font-size: 22rpx;
}

/* 已完成 */
.card-completed {
  background: #f9fef9;
}
.card-completed .card-title {
  color: #07c160;
  font-weight: 600;
}
.card-check {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 32rpx;
  height: 32rpx;
  background: #07c160;
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
}

/* ===== 图例 ===== */
.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 28rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.legend-dot.gray  { background: #d0d0d0; }
.legend-dot.blue  { background: #1296db; }
.legend-dot.green { background: #07c160; }

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.modal-handle {
  width: 72rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}

.modal-header {
  text-align: center;
  padding: 24rpx 40rpx 8rpx;
}

.modal-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}
.modal-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
  display: block;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
}

.modal-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.modal-options {
  padding: 20rpx 24rpx;
}

.modal-option {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.modal-option.active {
  border-color: #1296db;
  background: #f0f7ff;
}

.modal-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d0d0d0;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.modal-option.active .modal-radio {
  border-color: #1296db;
  background: #1296db;
}

.modal-radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fff;
}

.modal-option-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.modal-option-label {
  font-size: 28rpx;
  color: #333;
}

.modal-option.active .modal-option-label {
  color: #1296db;
  font-weight: 600;
}

.qrcode-wrap {
  margin: 0 24rpx 8rpx;
  text-align: center;
}
.qrcode-crop {
  width: 200rpx;
  height: 160rpx;
  margin: 0 auto;
  overflow: hidden;
  border-radius: 12rpx;
}
.qrcode-img {
  width: 200rpx;
}
.qrcode-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
}

.modal-btn {
  margin: 12rpx 24rpx 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1296db;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  border: none;
}

.modal-btn:active {
  opacity: 0.85;
}


